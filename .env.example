# 本地开发默认无需任何环境变量即可运行（pnpm next dev）。
# 以下变量仅在云端部署环境自动注入，本地不要手动填写：

# COZE_INTEGRATION_BASE_URL=   # AI/搜索集成网关地址（云端注入）
# COZE_PROJECT_ENV=            # DEV / PROD（云端注入）
# COZE_WORKSPACE_PATH=         # 云端工作目录（云端注入）

# 如需修改本地开发端口（默认 3000）：
# PORT=3000

# 1688 货源数据接口（可选，配置后选品 Agent 可检索真实货源价格/起订量/供应商）：
# 接口约定：POST { "query": "中文关键词", "limit": 5 }，Header 带 Authorization: Bearer <KEY>
# 响应：{ "offers": [{ "title": "...", "price": 12.5, "moq": 2, "supplier": "...",
#          "location": "...", "sales": "...", "repurchaseRate": "...", "url": "..." }] }
# （字段容忍常见别名，详见 src/lib/agent/sources/sourcing.ts）
# 未配置时 Agent 自动降级为输出 1688 直达搜索链接，不影响使用。
# SOURCING_1688_API_URL=
# SOURCING_1688_API_KEY=
